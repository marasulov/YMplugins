<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Подключение необходимых ресурсов Material Design -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="WindowResourceDictionary.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Шаблон для повторяющихся TextBox -->
    <ControlTemplate x:Key="TextBoxWithHintTemplate" TargetType="TextBox">
        <StackPanel>
            <TextBlock Text="{TemplateBinding Tag}" />
            <TextBox 
                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text}"
                
                materialDesign:TextFieldAssist.HasClearButton="True"
                Margin="8 0 8 0">
                <materialDesign:HintAssist.Hint>
                    <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                        <TextBlock Text="{TemplateBinding ToolTip}" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>
        </StackPanel>
    </ControlTemplate>
</ResourceDictionary>