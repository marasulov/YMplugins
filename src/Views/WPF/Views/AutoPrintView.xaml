<Window x:Class="YMplugins.Views.Views.AutoPrintView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign ="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vms="clr-namespace:YMplugins.ViewModels.VM;assembly=YMplugins.ViewModels"
        xmlns:converters="clr-namespace:YMplugins.Views.Converters"
        xmlns:loc="clr-namespace:YMplugins.Contracts.Localization;assembly=YMplugins.Contracts"
        d:DataContext="{d:DesignInstance {x:Type  vms:AutoPrintVm}, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Name="AutoPrint"
        Title="{x:Static loc:Tr.WindowTitle}" Height="700" Width="850" Style="{DynamicResource WindowElementStyle}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WindowResourceDictionary.xaml" />
                <ResourceDictionary Source="../Resources/TextBoxTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
        
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Header -->
            <!-- Naming -->
            <!-- Options -->
            <RowDefinition Height="Auto" />

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />


        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Левая часть: Радиокнопки для выбора -->
        <GroupBox Header="{x:Static loc:Tr.PrintBy}" Grid.Row="0" Grid.Column="0" Margin="1">
            <StackPanel>
                <StackPanel>
                    <RadioButton Content="{x:Static loc:Tr.CreatePdf}"
                                 Name="ToPdfRadioButton"
                                 IsChecked="{Binding IsCreatePdf}" />

                    <RadioButton Content="{x:Static loc:Tr.CreateDwg}" 
                                 Name="ToDwglineRadioButton"
                                 IsChecked="{Binding IsCreatePdf, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>
                <StackPanel>
                    <RadioButton Content="{x:Static loc:Tr.ByBlock}"
                                 Name="ByBlockRadioButton"
                                 IsChecked="{Binding SelectedPrintByOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ByBlock}" />
                    <RadioButton Content="{x:Static loc:Tr.ByPolyline}" 
                                 Name="ByPolylineRadioButton"
                                 IsChecked="{Binding SelectedPrintByOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ByPolyline}" />
                </StackPanel>
                <StackPanel>
                    <CheckBox IsChecked="{Binding IsSearchOnModel}" Content="{x:Static loc:Tr.SearchOnModel}" />
                    <CheckBox x:Name="SearchOnLayoutsCheckBox" IsChecked="{Binding IsSearchOnLayout}" Content="{x:Static loc:Tr.SearchOnLayouts}" />
                        <StackPanel Margin="20,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SearchOnLayoutsCheckBox, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=SearchOnLayoutsCheckBox, Path=IsChecked}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                        <CheckBox IsChecked="{Binding  IsDeleteEmptyLayouts, UpdateSourceTrigger=PropertyChanged}" Content="{x:Static loc:Tr.DeleteEmptyLayouts}" />
                            <CheckBox IsChecked="{Binding IsSetLayoutsToPlotSetting }" Content="{x:Static loc:Tr.SetLayoutsToPrintBorders}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                    <CheckBox Name="combineCheckBox" IsChecked="{Binding IsCombinePdf, UpdateSourceTrigger=PropertyChanged}" Content="{x:Static loc:Tr.CombinePdfs}" />
                </StackPanel>
                <StackPanel>
                    <TextBox  Name="outputFileTextbox"
                              Text="{Binding Path=OutputFileName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}"
                              Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                              materialDesign:TextFieldAssist.HasClearButton="True"
                              IsEnabled="{Binding IsChecked, ElementName=combineCheckBox}"
                              Margin="8 0 8 0">
                        <TextBox.ToolTip>
                            <ToolTip Visibility="{Binding (Validation.HasError), ElementName=outputFileTextbox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=outputFileTextbox}" />
                            </ToolTip>
                        </TextBox.ToolTip>
                        <materialDesign:HintAssist.Hint>
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="-2 0 0 0">
                                <TextBlock
                                    Text="{x:Static loc:Tr.EnterOutputFileName}" Cursor="" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Средняя часть: Комбобоксы и кнопки -->
            <GroupBox Margin="1">
                <StackPanel>
                    <!-- Комбобокс для Block -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{x:Static loc:Tr.SelectBlockName}" />
                        <ComboBox Width="200" Margin="0,0,0,10"
                      ItemsSource="{Binding BlocksNames}"
                      SelectedItem="{Binding SelectedBlockOnScreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedIndex="0"/>
                        <Button Content="{x:Static loc:Tr.SelectOnScreen}" Command="{Binding SelectBlockCommand }"  CommandParameter="{Binding }" />
                    </StackPanel>

                    <!-- Комбобокс для Polyline -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ByPolylineRadioButton, Path=IsChecked}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=ByPolylineRadioButton, Path=IsChecked}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{x:Static loc:Tr.SelectLayer}" />
                        <ComboBox Width="200" Margin="0,0,0,10" 
                      ItemsSource="{Binding  Layers}"
                      SelectedItem="{Binding SelectedLayerOnScreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedIndex="0" />
                        <Button Content="{x:Static loc:Tr.SelectOnLayerScreen}" Command="{Binding SelectedLayerOnScreen}"  CommandParameter="{Binding }" />
                        

                        <StackPanel >
                            <TextBlock Text="{x:Static loc:Tr.EnterPolylineScale}"></TextBlock>
                            <TextBox Text="{Binding PlineScale}"></TextBox>
                        </StackPanel>
                    </StackPanel>
                    
                </StackPanel>
            </GroupBox>
            <!-- Группа Printing order -->
            <GroupBox Header="{x:Static loc:Tr.PrintingOrder}" Grid.Row="1" Grid.Column="1" Margin="1">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Tr.PrintingNumberingOrder}" Margin="2 3 5 0" />
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <RadioButton Content="X" 
                                     IsChecked="{Binding SelectedPrintingOrder, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ByX}" />
                        <RadioButton Content="Y" 
                                     IsChecked="{Binding SelectedPrintingOrder, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ByY}" />
                        <!--<RadioButton Content="Select order" 
                                     IsChecked="{Binding SelectedPrintingOrder, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Custom}" />-->
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Группа Naming справа -->
        <GroupBox Header="{x:Static loc:Tr.Naming}" Grid.Row="0" Grid.Column="2" Margin="1">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{x:Static loc:Tr.AttributeValue}" />
                    <ComboBox  Margin="0,0,0,10"
                               VerticalAlignment="Center" Name="comboAttributes" Height="40"
                               ItemsSource="{Binding Attributes}"
                               SelectedItem="{Binding SelectedAttr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                               IsEnabled="{Binding IsChecked, ElementName=attributeCheckBox}"
                               FontSize="12"
                               VerticalContentAlignment="Center">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="-2 0 0 0">
                                <TextBlock
                                    Text="{x:Static loc:Tr.SelectAttribute}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Thin" xml:space="preserve"
                                                   Text="{x:Static loc:Tr.AttributeNameLabel}" />
                                        <TextBlock FontWeight="Medium" Name="AttrNameTextBlock"
                                                   Text="{Binding Path=AttributeName}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Thin" xml:space="preserve" Text="{x:Static loc:Tr.AttributeValueLabel}" />
                                        <TextBlock FontWeight="DemiBold" Name="attrValueTextBox"
                                                   Text="{Binding Path = AttributeValue}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="{x:Static loc:Tr.Numeration}" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox Name="numberingCheckbox"
                              IsChecked="{Binding IsCheckedNumbering, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,10,0" />
                    <TextBox  Name="numberingTextbox"
                          Text="{Binding Path= NumerationStartValue ,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                          materialDesign:TextFieldAssist.HasClearButton="True"
                          IsEnabled="{Binding IsChecked, ElementName=numberingCheckbox}"
                          Margin="8 0 8 0">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel
                            Orientation="Horizontal"
                            Margin="-2 0 0 0">
                                <TextBlock
                                Text="{x:Static loc:Tr.EnterNumberingStart}" Cursor="" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                </StackPanel>
                <TextBox Tag="{x:Static loc:Tr.PrefixTag}"
                         ToolTip="{x:Static loc:Tr.EnterPrefix}"
                         Text="{Binding Path=Prefix}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Template="{StaticResource TextBoxWithHintTemplate}" />

                <TextBox Tag="{x:Static loc:Tr.SuffixTag}"
                         ToolTip="{x:Static loc:Tr.EnterSuffix}"
                         Text="{Binding Path=Suffix}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Template="{StaticResource TextBoxWithHintTemplate}" />
            </StackPanel>
        </GroupBox>

        <!-- DataGrid для отображения данных блока -->
        <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Grid.Column="0">
            <GroupBox.Header>
                <!--<Label Content="{Binding ElementName=PrintCollection, Path=Items.Count}"
                       ContentStringFormat="Blocks found {0}"/>-->
                <Label Content="{Binding HeaderContent}" />
            </GroupBox.Header >
            <DataGrid ItemsSource="{Binding PrintDataCollection, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                      Name="PrintCollection"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="5"
                      MaxHeight="500"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- Пример колонок -->
                    <DataGridTextColumn Header="{x:Static loc:Tr.ColId}" Binding="{Binding ObjectId}" Width="Auto" />
                    <DataGridTextColumn Header="{x:Static loc:Tr.ColSpace}" Binding="{Binding Space}" Width="Auto" />
                    <DataGridTextColumn Header="{x:Static loc:Tr.ColFormat}" Binding="{Binding Format}" Width="*" />
                    <DataGridTextColumn Header="{x:Static loc:Tr.ColFileName}" Binding="{Binding FileName}" Width="*" />
                    <DataGridTemplateColumn Header="{x:Static loc:Tr.ColZoom}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ElementName = AutoPrint,
                                    Path= DataContext.ZoomToPointCommand}" 
                                    CommandParameter="{Binding  ObjectId}" 
                                    Content="{x:Static loc:Tr.ShowButton}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.Header>
                            <CheckBox Content="{x:Static loc:Tr.ColPrinting}" 
                                      IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsAllPrintSelected, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsPrint, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Кнопки внизу -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="3">
            <Button Content="{x:Static loc:Tr.PrintButton}" Width="100" Height="30" Margin="10" Command="{Binding PrintCommand}" CommandParameter="{Binding}" />
        </StackPanel>
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding Error}" 
                   Foreground="Red" 
                   TextWrapping="Wrap" 
                   Margin="5"/>
    </Grid>
</Window>