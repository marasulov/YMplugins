<Window x:Class="YMplugins.Views.Views.AutoPrintView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign ="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vms="clr-namespace:YMplugins.ViewModels.VM;assembly=YMplugins.ViewModels"
        xmlns:controls="clr-namespace:YMplugins.Views.Controls"
        d:DataContext="{d:DesignInstance {x:Type  vms:AutoPrintVm}, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="AutoPrintView" Height="500" Width="800" Style="{DynamicResource WindowElementStyle}" >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WindowResourceDictionary.xaml"/>
                <ResourceDictionary Source="../Resources/TextBoxTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><!-- Header -->
            <RowDefinition Height="*"/><!-- Options -->
            <RowDefinition Height="Auto"/><!-- Naming -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: Радиокнопки для выбора -->
        <GroupBox Header="Print by" Grid.Row="0" Grid.Column="0" Margin="1">
            <StackPanel>
                <RadioButton Name="ByBlockRadioButton" Content="By Block" GroupName="PrintBy" IsChecked="True" Margin="0,0,0,5"/>
                <RadioButton Name="ByPolylineRadioButton" Content="By Polyline" GroupName="PrintBy" Margin="0,0,0,5"/>
            </StackPanel>
        </GroupBox>

        <!-- Правая часть: Комбобоксы и кнопки -->
        <GroupBox Header="Options" Grid.Row="0" Grid.Column="1" Margin="1">
            <StackPanel>
                <!-- Комбобокс для Block -->
                <StackPanel Margin="0,0,0,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Select block name" />
                    <ComboBox Width="200" Margin="0,0,0,10"  ItemsSource="{Binding BlocksName}" SelectedItem="{Binding SelectedBlockId, Mode=TwoWay}" SelectedIndex="0"/>
                    <Button Content="Select on screen" Command="{Binding SelectBlockCommand }"  CommandParameter="{Binding }" />
                    <TextBlock Text="{Binding SelectedBlockId}"></TextBlock>
                </StackPanel>

                <!-- Комбобокс для Polyline -->
                <StackPanel Margin="0,0,0,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ByPolylineRadioButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=ByPolylineRadioButton, Path=IsChecked}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Select layer" />
                    <ComboBox Width="200" Margin="0,0,0,10" ItemsSource="{Binding  Layers}" SelectedIndex="0"/>
                    <Button Content="Select on screen" Command="{Binding SelectBlockCommand}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Группа Naming снизу -->
        <GroupBox Header="Naming" Grid.Row="1" Margin="1">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=ByBlockRadioButton, Path=IsChecked}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Attribute value:" />
                    <ComboBox  Margin="0,0,0,10" ItemsSource="{Binding Attributes}" SelectedItem="{Binding SelectedAttribute, Mode=TwoWay}" SelectedIndex="0"/>
                </StackPanel>

                <TextBlock Text="Numeration:" />
                <TextBox  Name="numberingTextbox"
                          controls:NumberOnly.IsEnabled="True"
                          Text="{Binding Path= RenumberStartValue ,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                          materialDesign:TextFieldAssist.HasClearButton="True"
                          IsEnabled="{Binding IsChecked, ElementName=numberingCheckbox}"
                          Margin="8 0 8 0">
                    <materialDesign:HintAssist.Hint>
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="-2 0 0 0">
                            <TextBlock
                                Text="Enter numbering start value" Cursor="" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>

                <TextBox Grid.Column="2" Grid.Row="2"
                         Tag="Prefix:"
                         ToolTip="Enter prefix"
                         Text="{Binding Path=Prefix}"
                         Template="{StaticResource TextBoxWithHintTemplate}" />
                <TextBox Grid.Column="2" Grid.Row="3"
                         Tag="Suffix:"
                         ToolTip="Enter suffix"
                         Text="{Binding Path=Suffix}"
                         Template="{StaticResource TextBoxWithHintTemplate}" />
                
            </StackPanel>
        </GroupBox>

        <!-- Кнопки внизу -->
        <DockPanel LastChildFill="True" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1">
            <Button Content="OK"  DockPanel.Dock="Right" Margin="5" Command="{Binding PrintCommand}" CommandParameter="{Binding }"/>
            <Button Content="Cancel" DockPanel.Dock="Right" Margin="5"/>
        </DockPanel>
    </Grid>


</Window>
