<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release;Autocad;Test</Configurations>
    
    <UseWPF>true</UseWPF>
    
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="conf.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SimpleInjector" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Services\YMplugins.Services\YMplugins.Services.csproj" />
    <ProjectReference Include="..\..\ViewModels\YMplugins.ViewModels.csproj" />
    <ProjectReference Include="..\..\Views\WPF\YMplugins.Views.csproj" />
    <ProjectReference Include="..\YMplugins.Models.DbCad\YMplugins.Models.DbCad.csproj" />
  </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="AutoCAD.NET" Version="24.3.0" ExcludeAssets="runtime" />

		<Reference Include="Gile.AutoCAD.R20.Extension">
			<HintPath>..\..\libs\Gile.AutoCAD.R20.Extension.dll</HintPath>
			<Private>True</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<PackageReference Include="AutoCAD.NET" Version="25.0.0" ExcludeAssets="runtime" />

		<PackageReference Include="AutoCAD.NET.Core" Version="25.0.0" ExcludeAssets="runtime" />
		<PackageReference Include="AutoCAD.NET.Model" Version="25.0.0" ExcludeAssets="runtime" />

		<Reference Include="Gile.AutoCAD.R25.Extension">
			<HintPath>..\..\libs\Gile.AutoCAD.R25.Extension.dll</HintPath>
			<Private>True</Private>
		</Reference>
	</ItemGroup>

</Project>